#!/bin/bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/scripts/common.sh"
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  echo 'Usage: ./enroll [label] — capture another distance or angle; existing faces are retained.'
  exit 0
fi
(( $# <= 1 )) || fail 'Supply at most one quoted enrollment label.'
require_desktop
require_facelock
[[ -t 0 ]] || fail 'Enrollment requires a visible terminal.'
sudo -v
printf 'Sit at a normal distance and keep your face visible. Press Enter, then slowly turn your head.\n'
read -r
sudo /usr/bin/facelock enroll --user "$(id -un)" --label "${1:-Additional angle $(date +%Y-%m-%d_%H-%M-%S)}"
facelock is-enrolled --quiet || fail 'No usable enrollment found.'
printf '\nPress Enter to test recognition at the same distance.\n'
read -r
sudo /usr/bin/facelock test --user "$(id -un)"
echo 'Read the result: a zero exit status alone does not mean recognition succeeded.'
